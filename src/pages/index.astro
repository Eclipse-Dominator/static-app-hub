---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import Icon from '../components/Icon.astro';
import { apps, categoryLabel } from '../lib/registry';

const categoryCounts = new Map<string, number>();
for (const app of apps) {
  categoryCounts.set(app.category, (categoryCounts.get(app.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base search description="Quick downloads for my apps and tools.">
  <div class="container library-page">
    <h1 class="visually-hidden">Apps</h1>
    <span class="visually-hidden" id="results-count" aria-live="polite">
      {apps.length} app{apps.length === 1 ? '' : 's'}
    </span>

    <div class="filters">
      <div class="chips" role="group" aria-label="Filter by platform">
        <button class="chip" type="button" data-platform="all" aria-pressed="true">All</button>
        <button class="chip" type="button" data-platform="windows" aria-pressed="false">Windows</button>
        <button class="chip" type="button" data-platform="macos" aria-pressed="false">macOS</button>
        <button class="chip" type="button" data-platform="linux" aria-pressed="false">Linux</button>
      </div>

      <div class="filters-spacer"></div>

      <div class="select-wrap">
        <label class="visually-hidden" for="category-select">Category</label>
        <select class="select" id="category-select">
          <option value="all">All categories</option>
          {categories.map(([category, count]) => (
            <option value={category}>{categoryLabel(category as never)} ({count})</option>
          ))}
        </select>
        <Icon name="chevron-down" size={14} />
      </div>

      <div class="select-wrap">
        <label class="visually-hidden" for="sort-select">Sort</label>
        <select class="select" id="sort-select">
          <option value="recommended">Default</option>
          <option value="newest">Newest</option>
          <option value="name">A–Z</option>
        </select>
        <Icon name="chevron-down" size={14} />
      </div>
    </div>

    <div class="app-grid" id="app-grid">
      {apps.map((app, index) => <AppCard app={app} index={index} />)}
    </div>

    <div class="empty-state" id="empty-state">
      <h2>No matching apps</h2>
      <button class="btn btn-small" type="button" id="clear-filters">Clear filters</button>
    </div>
  </div>

  <script>
    import '../scripts/filters';
  </script>
</Base>

<style>
  .library-page {
    padding-top: 22px;
  }

  .library-page .filters {
    margin-bottom: 18px;
    padding: 0 0 14px;
    border-top: 0;
  }

  .library-page .empty-state {
    margin-bottom: 40px;
  }

  @media (max-width: 640px) {
    .library-page {
      padding-top: 18px;
    }
  }
</style>
