---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import Icon from '../components/Icon.astro';
import { apps, categoryLabel } from '../lib/registry';

const categoryCounts = new Map<string, number>();
for (const app of apps) {
  categoryCounts.set(app.category, (categoryCounts.get(app.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base description="Quick downloads for my apps and tools.">
  <div class="container library-page">
    <header class="library-head">
      <div class="library-heading">
        <h1 class="library-title">Apps</h1>
        <span class="library-count" id="results-count" aria-live="polite">
          {apps.length} app{apps.length === 1 ? '' : 's'}
        </span>
      </div>

      <div class="search library-search">
        <Icon name="search" size={18} />
        <label class="visually-hidden" for="app-search">Search apps</label>
        <input
          id="app-search"
          type="search"
          placeholder="Search…"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="results-count"
        />
        <kbd>/</kbd>
      </div>
    </header>

    <div class="filters">
      <span class="filters-label">Platform</span>
      <div class="chips" role="group" aria-label="Filter by platform">
        <button class="chip" type="button" data-platform="all" aria-pressed="true">All</button>
        <button class="chip" type="button" data-platform="windows" aria-pressed="false">Windows</button>
        <button class="chip" type="button" data-platform="macos" aria-pressed="false">macOS</button>
        <button class="chip" type="button" data-platform="linux" aria-pressed="false">Linux</button>
      </div>

      <div class="filters-spacer"></div>

      <div class="select-wrap">
        <label class="visually-hidden" for="category-select">Category</label>
        <select class="select" id="category-select">
          <option value="all">All categories</option>
          {categories.map(([category, count]) => (
            <option value={category}>{categoryLabel(category as never)} ({count})</option>
          ))}
        </select>
        <Icon name="chevron-down" size={14} />
      </div>

      <div class="select-wrap">
        <label class="visually-hidden" for="sort-select">Sort</label>
        <select class="select" id="sort-select">
          <option value="recommended">Default</option>
          <option value="newest">Newest</option>
          <option value="name">A–Z</option>
        </select>
        <Icon name="chevron-down" size={14} />
      </div>
    </div>

    <div class="app-grid" id="app-grid">
      {apps.map((app, index) => <AppCard app={app} index={index} />)}
    </div>

    <div class="empty-state" id="empty-state">
      <h2>No matching apps</h2>
      <button class="btn btn-small" type="button" id="clear-filters">Clear filters</button>
    </div>
  </div>

  <script>
    import '../scripts/filters';
  </script>
</Base>

<style>
  .library-page {
    padding-top: 42px;
  }

  .library-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding-bottom: 14px;
  }

  .library-heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .library-title {
    font-size: clamp(1.8rem, 3.5vw, 2.35rem);
    letter-spacing: -0.035em;
  }

  .library-count {
    color: var(--muted-2);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .library-search {
    flex: 1 1 280px;
    max-width: 420px;
    margin-top: 0;
  }

  .library-search input {
    height: 44px;
    box-shadow: none;
  }

  .library-page .filters {
    margin-bottom: 18px;
    padding: 14px 0;
  }

  .library-page .empty-state {
    margin-bottom: 40px;
  }

  @media (max-width: 640px) {
    .library-page {
      padding-top: 28px;
    }

    .library-head {
      padding-bottom: 10px;
    }

    .library-search {
      flex-basis: 100%;
      max-width: none;
    }
  }
</style>
