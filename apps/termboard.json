{
  "$schema": "../../schemas/app.schema.json",
  "id": "termboard",
  "name": "Termboard",
  "tagline": "A keyboard-first dashboard for your terminal.",
  "description": "Termboard keeps the things you check a hundred times a day in one place: repository status, CI runs, open pull requests, and your calendar — all rendered in a fast, fully keyboard-driven TUI.\n\nIt ships as a single static binary, starts in under 50 ms, and never phones home.",
  "category": "developer-tools",
  "tags": ["tui", "git", "dashboard", "cross-platform"],
  "icon": "/icons/termboard.svg",
  "accent": "#7cf29c",
  "featured": true,
  "license": "MIT",
  "author": {
    "name": "Termboard Contributors",
    "url": "https://github.com/example/termboard"
  },
  "links": {
    "repo": "https://github.com/example/termboard",
    "docs": "https://github.com/example/termboard#readme",
    "issues": "https://github.com/example/termboard/issues"
  },
  "install": {
    "brew": "brew install example/tap/termboard",
    "cargo": "cargo install termboard",
    "script": "curl -fsSL https://downloads.example.com/termboard/install.sh | sh"
  },
