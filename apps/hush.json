{
  "$schema": "../../schemas/app.schema.json",
  "id": "hush",
  "name": "Hush",
  "tagline": "Secrets management for people who live in a shell.",
  "description": "Hush is a small, auditable secrets manager. It encrypts environment files with age, keeps them in your existing git repository, and injects them into any process at runtime.\n\nNo server, no daemon, no proprietary format: just a CLI, a git-friendly file layout, and a clear threat model.",
  "category": "security",
  "tags": ["cli", "secrets", "encryption", "devops"],
  "icon": "/icons/hush.svg",
  "accent": "#8ab4ff",
  "license": "AGPL-3.0",
  "author": {
    "name": "Hush Labs"
  },
  "links": {
    "repo": "https://github.com/example/hush",
    "docs": "https://hush.example.com/docs",
    "discussions": "https://github.com/example/hush/discussions"
  },
  "install": {
    "brew": "brew install example/tap/hush",
    "scoop": "scoop install hush",
    "go": "go install github.com/example/hush/cmd/hush@latest",
    "script": "curl -fsSL https://hush.example.com/install.sh | sh",
    "powershell": "irm https://hush.example.com/install.ps1 | iex"
  },
  "releases": [
