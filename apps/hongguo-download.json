{
  "$schema": "https://raw.githubusercontent.com/Eclipse-Dominator/static-app-hub/main/schemas/app.schema.json",
  "id": "hongguo-download",
  "name": "Hongguo Download",
  "tagline": "A lightweight Linux/Windows desktop downloader for Hongguo short dramas, with batch episode downloads.",
  "description": "Hongguo Download is a Tauri-based desktop app for saving Hongguo short-drama episodes for personal offline viewing.\n\n- Lightweight Tauri 2 shell with a Rust backend; no Electron.\n- Linux and Windows builds from the same codebase.\n- Resolve a share link, select episodes by range, and download in batches.\n- Default App source uses an anonymous device identity; no account login is required.\n- Optional 360p web source and an in-app web login fallback.\n- ByteVC2-only episodes are converted to H.264/AAC with a bundled librempeg helper, as H.264 or H.265/HEVC, with high/balanced/small quality presets.\n- Resumable downloads, per-episode progress, cancellation, and cross-platform file naming.\n\n> For personal use only. Respect Hongguo's terms of service and local copyright law. This is an unofficial tool and does not grant rights to redistribute content.",
  "category": "media",
  "tags": [
    "video",
    "downloader",
    "short-drama",
    "tauri",
    "cross-platform"
  ],
  "accent": "#ff3b5c",
