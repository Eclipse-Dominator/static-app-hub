  "$schema": "https://raw.githubusercontent.com/Eclipse-Dominator/static-app-hub/main/schemas/app.schema.json",
  "id": "wxshort",
  "name": "wxshort",
  "tagline": "Lightweight WeChat Channels downloader with a queue, per-item quality and QR login for Windows and Linux.",
  "description": "A small, dependency-free GUI/CLI downloader for **WeChat Channels** (视频号) videos.\n\n- Download queue with per-item quality, progress, speed/ETA, retry and remove actions\n- Share-link parsing, direct CDN URLs and pluggable resolvers\n- In-app WeChat QR login with automatic cookie capture\n- English and Simplified Chinese interface\n- Streaming downloads with resume support\n- No Electron or browser runtime; the GUI uses Tkinter",
  "category": "media",
  "tags": [
    "wechat",
    "video-downloader",
    "tkinter",
    "cross-platform"
  ],
  "accent": "#22c55e",
