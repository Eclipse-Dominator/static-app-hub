{
  "$schema": "../../schemas/app.schema.json",
  "id": "pixelforge",
  "name": "PixelForge",
  "tagline": "Batch image processing that doesn't get in your way.",
  "description": "PixelForge is a desktop app for converting, resizing, and optimising images in bulk. Drop in a folder, pick a recipe, and get predictable results — with a live preview and a non-destructive history.\n\nRecipes are plain JSON, so they can be versioned, shared, and run from CI with the bundled `forge` CLI.",
  "category": "media",
  "tags": ["images", "converter", "batch", "desktop"],
  "icon": "/icons/pixelforge.svg",
  "accent": "#ff9f6e",
  "featured": true,
  "license": "Apache-2.0",
  "author": {
    "name": "PixelForge Studio"
  },
  "links": {
    "homepage": "https://pixelforge.example.com",
    "repo": "https://github.com/example/pixelforge",
    "changelog": "https://pixelforge.example.com/changelog"
  },
  "install": {
    "winget": "winget install PixelForge.Studio.PixelForge",
    "brew": "brew install --cask pixelforge",
    "script": "curl -fsSL https://pixelforge.example.com/install.sh | sh"
  },
